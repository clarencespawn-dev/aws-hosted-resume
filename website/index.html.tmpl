<style>
/* ─── TOKENS — deep space palette ───────────────────────── */
:root {
  --ivory:       #05060D;   /* page void */
  --white:       #11142B;   /* card / panel surface */
  --ink:         #F3F1FF;   /* primary text — near white, violet tint */
  --ink-2:       #C7C3E8;   /* secondary text */
  --muted:       #8B87B0;   /* muted text */
  --faint:       rgba(255,255,255,0.10);  /* borders */
  --blue:        #9D7CFF;   /* nebula violet — primary accent */
  --blue-mid:    #6FE3FF;   /* nebula cyan — secondary accent */
  --blue-light:  rgba(157,124,255,0.14);
  --amber:       #FFC56B;
  --amber-bg:    rgba(255,197,107,0.12);
  --green:       #5FE3A0;
  --green-bg:    rgba(95,227,160,0.12);
  --shadow-sm:   0 1px 4px rgba(0,0,0,.35), 0 1px 2px rgba(0,0,0,.25);
  --shadow-md:   0 4px 20px rgba(124,92,255,.14), 0 2px 8px rgba(0,0,0,.4);
  --shadow-lg:   0 14px 44px rgba(124,92,255,.22), 0 4px 14px rgba(0,0,0,.5);
  --r:           12px;
  --r-sm:        8px;
  --spring:      cubic-bezier(0.34, 1.56, 0.64, 1);
  --ease-out:    cubic-bezier(0.22, 1, 0.36, 1);
  --display:     'Outfit', sans-serif;
  --body:        'Inter', sans-serif;
  --mono:        'JetBrains Mono', ui-monospace, monospace;
}

/* ─── RESET ──────────────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { background: var(--ivory); scroll-behavior: smooth; }
body {
  font-family: var(--body);
  color: var(--ink);
  background:
    radial-gradient(ellipse 900px 600px at 15% 0%, rgba(157,124,255,.10) 0%, transparent 55%),
    radial-gradient(ellipse 700px 500px at 85% 15%, rgba(111,227,255,.07) 0%, transparent 55%),
    var(--ivory);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
  position: relative;
}

/* ─── STARFIELD ──────────────────────────────────────── */
#starfield {
  position: fixed; inset: 0;
  z-index: -1;
  pointer-events: none;
}
a { color: var(--blue); text-decoration: none; }
a:hover { text-decoration: underline; }
a:focus-visible, button:focus-visible, input:focus-visible, textarea:focus-visible {
  outline: 2px solid var(--blue);
  outline-offset: 3px;
  border-radius: 3px;
}

/* ─── PROGRESS BAR ───────────────────────────────────── */
#progress-bar {
  position: fixed; top: 0; left: 0;
  height: 3px; width: 0%;
  background: linear-gradient(90deg, var(--blue), var(--blue-mid));
  z-index: 100;
  transition: width 0.08s linear;
  border-radius: 0 2px 2px 0;
}

/* ─── NAV ─────────────────────────────────────────────── */
nav {
  position: fixed; top: 3px; left: 0; right: 0; z-index: 50;
  background: rgba(5,6,13,0.75);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid rgba(26,25,36,.06);
}
.nav-inner {
  max-width: 1060px; margin: 0 auto; padding: 14px 32px;
  display: flex; align-items: center; justify-content: space-between;
}
.nav-logo {
  font-family: var(--display); font-weight: 700; font-size: 17px;
  color: var(--ink); letter-spacing: -.01em; text-decoration: none;
}
.nav-logo span { color: var(--blue); }
.nav-links { display: flex; gap: 4px; list-style: none; }
.nav-links a {
  font-size: 13.5px; font-weight: 500; color: var(--muted);
  padding: 6px 14px; border-radius: 100px;
  transition: color .18s, background .18s;
}
.nav-links a:hover { color: var(--ink); background: var(--faint); text-decoration: none; }
@media (max-width: 640px) { .nav-links { display: none; } }

/* ─── LAYOUT ─────────────────────────────────────────── */
.page { max-width: 1060px; margin: 0 auto; padding: 0 32px; }
section { padding: 104px 0 0; }
@media (max-width: 768px) {
  .page { padding: 0 20px; }
  section { padding: 80px 0 0; }
}

/* ─── HERO ───────────────────────────────────────────── */
.hero {
  min-height: 100svh;
  display: flex; align-items: center;
  position: relative; overflow: hidden;
  padding: 130px 0 80px;
}

/* ─── BLACK HOLE ─────────────────────────────────────── */
.blackhole {
  position: absolute;
  top: -80px; right: -120px;
  width: 480px; height: 480px;
  pointer-events: none;
  z-index: 0;
}
.blackhole-glow {
  position: absolute; inset: -60px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(157,124,255,.22) 0%, rgba(111,227,255,.10) 40%, transparent 70%);
  filter: blur(40px);
  animation: glowPulse 6s ease-in-out infinite;
}
@keyframes glowPulse {
  0%,100% { opacity: .8; transform: scale(1); }
  50%      { opacity: 1; transform: scale(1.06); }
}
.blackhole-disk {
  position: absolute; inset: 0;
  border-radius: 50%;
  background: conic-gradient(
    from 0deg,
    transparent 0deg,
    rgba(111,227,255,.55) 40deg,
    rgba(157,124,255,.75) 110deg,
    rgba(255,197,107,.45) 160deg,
    transparent 200deg,
    transparent 260deg,
    rgba(157,124,255,.6) 320deg,
    transparent 360deg
  );
  -webkit-mask: radial-gradient(circle, transparent 38%, #000 42%, #000 58%, transparent 62%);
          mask: radial-gradient(circle, transparent 38%, #000 42%, #000 58%, transparent 62%);
  animation: spinDisk 26s linear infinite;
  filter: blur(1px);
}
@keyframes spinDisk {
  to { transform: rotate(360deg); }
}
.blackhole-core {
  position: absolute; inset: 0;
  margin: auto;
  width: 38%; height: 38%;
  border-radius: 50%;
  background: radial-gradient(circle, #000 55%, #05060D 100%);
  box-shadow: 0 0 50px 14px rgba(157,124,255,.25), inset 0 0 30px rgba(0,0,0,.9);
}

/* ─── NEBULA CLOUDS ──────────────────────────────────── */
.nebula {
  position: absolute; border-radius: 50%;
  filter: blur(90px); pointer-events: none;
  animation: drift 22s ease-in-out infinite;
  z-index: 0;
}
.nebula-1 {
  width: 460px; height: 380px;
  background: radial-gradient(ellipse, rgba(255,107,200,.10) 0%, rgba(157,124,255,.08) 45%, transparent 72%);
  bottom: -100px; left: -120px;
}
.nebula-2 {
  width: 340px; height: 300px;
  background: radial-gradient(ellipse, rgba(111,227,255,.09) 0%, transparent 70%);
  bottom: 40px; left: 220px;
  animation-delay: -11s; animation-direction: reverse;
}
@keyframes drift {
  0%,100% { transform: translate(0,0) scale(1); }
  33%      { transform: translate(26px,-16px) scale(1.04); }
  66%      { transform: translate(-16px,12px) scale(.96); }
}

.hero-content { position: relative; z-index: 1; max-width: 720px; }

/* Staggered fade-up intro — each child has its own delay */
.hero-eyebrow {
  display: inline-flex; align-items: center; gap: 8px;
  font-size: 13px; font-weight: 500;
  color: var(--blue); background: var(--blue-light);
  border: 1px solid rgba(157,124,255,.2);
  padding: 6px 14px; border-radius: 100px;
  margin-bottom: 30px;
  opacity: 0; transform: translateY(14px);
  animation: fadeUp .6s var(--ease-out) .15s forwards;
}
.pulse-dot {
  width: 7px; height: 7px; border-radius: 50%; background: var(--blue);
  animation: pulseDot 2.2s ease-in-out infinite;
}
@keyframes pulseDot {
  0%,100% { opacity: 1; transform: scale(1); }
  50%      { opacity: .35; transform: scale(.8); }
}

.hero-name {
  font-family: var(--display); font-weight: 800;
  font-size: clamp(54px, 9vw, 100px);
  line-height: .98; letter-spacing: -.035em;
  color: var(--ink); margin-bottom: 20px;
  opacity: 0; transform: translateY(22px);
  animation: fadeUp .75s var(--ease-out) .3s forwards;
}
.hero-name .accent { color: var(--blue); }

.hero-tagline {
  font-family: var(--display); font-weight: 400;
  font-size: clamp(18px, 2.8vw, 23px);
  color: var(--ink-2); margin-bottom: 22px;
  opacity: 0; transform: translateY(16px);
  animation: fadeUp .7s var(--ease-out) .45s forwards;
  display: flex; align-items: center; gap: 0; flex-wrap: wrap;
}
.tagline-from { color: var(--muted); }
.tagline-arrow {
  display: inline-block; margin: 0 12px;
  color: var(--blue); font-size: 20px;
  animation: arrowBounce 2.6s ease-in-out 1.8s infinite;
}
.tagline-to { color: var(--ink); font-weight: 600; }
@keyframes arrowBounce {
  0%,100% { transform: translateX(0); opacity: 1; }
  50%      { transform: translateX(6px); opacity: .5; }
}

.hero-desc {
  font-size: 16.5px; color: var(--muted); line-height: 1.72;
  max-width: 50ch; margin-bottom: 38px;
  opacity: 0; transform: translateY(14px);
  animation: fadeUp .7s var(--ease-out) .58s forwards;
}

.hero-ctas {
  display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 50px;
  opacity: 0; transform: translateY(12px);
  animation: fadeUp .7s var(--ease-out) .7s forwards;
}

.btn-primary {
  display: inline-flex; align-items: center; gap: 8px;
  background: var(--ink); color: #fff;
  font-family: var(--display); font-weight: 600; font-size: 14.5px;
  padding: 13px 26px; border-radius: 100px;
  transition: background .2s, transform .25s var(--spring), box-shadow .2s;
  text-decoration: none;
}
.btn-primary:hover {
  background: var(--blue); color: #fff; text-decoration: none;
  transform: translateY(-2px);
  box-shadow: 0 8px 22px rgba(157,124,255,.32);
}
.btn-secondary {
  display: inline-flex; align-items: center; gap: 8px;
  background: transparent; color: var(--ink-2);
  font-family: var(--display); font-weight: 600; font-size: 14.5px;
  padding: 12px 24px; border-radius: 100px;
  border: 1.5px solid var(--faint);
  transition: border-color .2s, color .2s, transform .25s var(--spring);
  text-decoration: none;
}
.btn-secondary:hover {
  border-color: var(--ink); color: var(--ink); text-decoration: none;
  transform: translateY(-2px);
}

.hero-contacts {
  display: flex; flex-wrap: wrap; gap: 20px;
  opacity: 0; transform: translateY(10px);
  animation: fadeUp .65s var(--ease-out) .82s forwards;
}
.hero-contact-item {
  display: flex; align-items: center; gap: 7px;
  font-size: 13.5px; color: var(--muted);
}
.hero-contact-item a { color: var(--muted); }
.hero-contact-item a:hover { color: var(--blue); }
.hero-contact-item svg { color: var(--blue); flex-shrink: 0; }

/* ─── STATS STRIP ────────────────────────────────────── */
.stats-strip {
  display: grid; grid-template-columns: repeat(4,1fr);
  gap: 1px; background: var(--faint);
  border: 1px solid var(--faint); border-radius: var(--r);
  overflow: hidden; margin: 72px 0 0;
}
.stat-card {
  background: var(--white); padding: 26px 22px;
  transition: background .2s;
}
.stat-card:hover { background: var(--blue-light); }
.stat-label {
  font-size: 11px; font-weight: 600; letter-spacing: .08em;
  text-transform: uppercase; color: var(--muted); margin-bottom: 8px;
}
.stat-value {
  font-family: var(--display); font-weight: 700;
  font-size: 27px; color: var(--ink);
  line-height: 1.1; letter-spacing: -.02em;
}
.stat-value.blue { color: var(--blue); }
.stat-value.sm   { font-size: 18px; letter-spacing: -.01em; }
.stat-sub { margin-top: 5px; font-size: 12px; color: var(--muted); font-family: var(--mono); }
@media (max-width: 640px) { .stats-strip { grid-template-columns: repeat(2,1fr); } }

/* ─── SECTION HEADER ─────────────────────────────────── */
.eyebrow {
  display: inline-flex; align-items: center; gap: 8px;
  font-size: 11.5px; font-weight: 600; letter-spacing: .1em;
  text-transform: uppercase; color: var(--blue); margin-bottom: 14px;
}
.eyebrow::before {
  content: ''; display: block; width: 22px; height: 2px;
  background: var(--blue); border-radius: 2px;
}
h2.section-title {
  font-family: var(--display); font-weight: 700;
  font-size: clamp(30px, 4.5vw, 44px);
  letter-spacing: -.025em; line-height: 1.1;
  color: var(--ink); margin-bottom: 16px;
}
.section-lead {
  font-size: 16.5px; color: var(--muted); max-width: 56ch;
  line-height: 1.68; margin-bottom: 52px;
}

/* ─── SCROLL REVEAL ──────────────────────────────────── */
.reveal {
  opacity: 0; transform: translateY(28px);
  transition: opacity .65s var(--ease-out), transform .65s var(--ease-out);
}
.reveal.visible { opacity: 1; transform: translateY(0); }

/* ─── ABOUT ──────────────────────────────────────────── */
.about-grid {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 52px; align-items: start;
}
.about-text p {
  color: var(--ink-2); font-size: 15.5px; line-height: 1.78;
  margin-bottom: 18px;
}
.about-text p:last-child { margin-bottom: 0; }

.sidebar-card {
  background: var(--white); border: 1px solid var(--faint);
  border-radius: var(--r); padding: 26px; box-shadow: var(--shadow-sm);
}
.sidebar-label {
  font-size: 11px; font-weight: 600; letter-spacing: .08em;
  text-transform: uppercase; color: var(--muted); margin-bottom: 16px;
}
.cert-row {
  display: flex; align-items: flex-start; gap: 13px;
  padding: 13px 0; border-bottom: 1px solid var(--faint);
}
.cert-row:last-child { border-bottom: none; padding-bottom: 0; }
.cert-row:first-child { padding-top: 0; }
.cert-icon {
  width: 36px; height: 36px; border-radius: 9px;
  display: flex; align-items: center; justify-content: center;
  font-size: 16px; flex-shrink: 0;
}
.cert-icon.amber { background: var(--amber-bg); }
.cert-icon.blue  { background: var(--blue-light); }
.cert-name { font-weight: 600; font-size: 13.5px; color: var(--ink); line-height: 1.3; }
.cert-org  { font-size: 12px; color: var(--muted); margin-top: 2px; }
.badge {
  display: inline-block; font-size: 10.5px; font-weight: 600;
  letter-spacing: .06em; text-transform: uppercase;
  padding: 2px 9px; border-radius: 100px; margin-top: 5px;
}
.badge-amber { background: var(--amber-bg); color: var(--amber); border: 1px solid rgba(255,197,107,.25); }
.badge-blue  { background: var(--blue-light); color: var(--blue);  border: 1px solid rgba(157,124,255,.25); }
@media (max-width: 768px) { .about-grid { grid-template-columns: 1fr; gap: 32px; } }

/* ─── SKILLS ─────────────────────────────────────────── */
.skill-group { margin-bottom: 40px; }
.skill-group:last-child { margin-bottom: 0; }
.skill-group-label {
  font-size: 11.5px; font-weight: 600; letter-spacing: .09em;
  text-transform: uppercase; color: var(--muted);
  margin-bottom: 14px; padding-bottom: 10px;
  border-bottom: 1px solid var(--faint);
}
.chip-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(228px,1fr));
  gap: 10px;
}
.chip {
  background: var(--white); border: 1px solid var(--faint);
  border-radius: var(--r-sm); padding: 13px 15px;
  display: flex; align-items: flex-start; gap: 11px;
  box-shadow: var(--shadow-sm);
  opacity: 0; transform: translateY(14px) scale(.97);
  transition: box-shadow .22s, transform .22s var(--spring), border-color .22s, opacity .4s var(--spring);
}
.chip.in { opacity: 1; transform: none; }
.chip:hover {
  box-shadow: var(--shadow-md); border-color: rgba(157,124,255,.28);
  transform: translateY(-3px) scale(1.01);
}
.chip-dot {
  width: 8px; height: 8px; border-radius: 50%;
  margin-top: 5px; flex-shrink: 0;
}
.chip-dot.ok  { background: var(--green); box-shadow: 0 0 0 3px rgba(95,227,160,.15); }
.chip-dot.wip { background: var(--amber); box-shadow: 0 0 0 3px rgba(255,197,107,.15); }
.chip-name { font-weight: 600; font-size: 13.5px; color: var(--ink); }
.chip-desc { font-size: 12px; color: var(--muted); margin-top: 2px; line-height: 1.4; }

/* ─── PROJECTS ───────────────────────────────────────── */
.project-grid {
  display: grid; grid-template-columns: repeat(2,1fr); gap: 20px;
  max-width: 760px;
}
.project-card {
  background: var(--white); border: 1px solid var(--faint);
  border-radius: var(--r); padding: 28px;
  box-shadow: var(--shadow-sm);
  display: flex; flex-direction: column;
  position: relative; overflow: hidden;
  transition: box-shadow .3s var(--ease-out), transform .3s var(--spring), border-color .3s;
}
.project-card::after {
  content: '';
  position: absolute; inset: 0;
  background: linear-gradient(140deg, var(--blue-light) 0%, transparent 55%);
  opacity: 0; transition: opacity .3s;
  pointer-events: none;
}
.project-card:hover {
  box-shadow: var(--shadow-lg); border-color: rgba(157,124,255,.28);
  transform: translateY(-5px) rotate(-.3deg);
}
.project-card:hover::after { opacity: 1; }
.project-card:nth-child(2):hover { transform: translateY(-5px) rotate(.3deg); }
.project-card:nth-child(3):hover { transform: translateY(-5px) rotate(-.2deg); }

.project-top {
  display: flex; align-items: flex-start;
  justify-content: space-between; margin-bottom: 14px; position: relative;
}
.project-emoji {
  width: 44px; height: 44px; border-radius: var(--r-sm);
  background: var(--blue-light); display: flex; align-items: center;
  justify-content: center; font-size: 20px;
  transition: transform .3s var(--spring);
}
.project-card:hover .project-emoji { transform: scale(1.12) rotate(-5deg); }
.project-link-icon {
  font-size: 16px; color: var(--muted); line-height: 1; margin-top: 4px;
  transition: transform .22s, color .22s;
}
.project-card:hover .project-link-icon { transform: translate(3px,-3px); color: var(--blue); }

.project-title {
  font-family: var(--display); font-weight: 700;
  font-size: 17px; color: var(--ink);
  letter-spacing: -.01em; margin-bottom: 8px; position: relative;
}
.project-desc {
  font-size: 13.5px; color: var(--muted); line-height: 1.6;
  flex: 1; margin-bottom: 18px; position: relative;
}
.tag-row { display: flex; flex-wrap: wrap; gap: 6px; position: relative; }
.tag {
  font-family: var(--mono); font-size: 10.5px;
  color: var(--blue); background: var(--blue-light);
  padding: 3px 9px; border-radius: 100px;
  border: 1px solid rgba(157,124,255,.18);
}
.tag.here { color: var(--green); background: var(--green-bg); border-color: rgba(95,227,160,.2); }
.tag.wip  { color: var(--amber); background: var(--amber-bg); border-color: rgba(255,197,107,.25); }

@media (max-width: 900px) { .project-grid { grid-template-columns: 1fr 1fr; } }
@media (max-width: 580px) { .project-grid { grid-template-columns: 1fr; } }

/* ─── TIMELINE ───────────────────────────────────────── */
.timeline { position: relative; }
.timeline::before {
  content: ''; position: absolute;
  left: 20px; top: 0; bottom: 0; width: 2px;
  background: linear-gradient(to bottom, var(--blue) 0%, var(--faint) 100%);
}
.tl-entry { position: relative; padding: 0 0 52px 62px; }
.tl-entry:last-child { padding-bottom: 0; }
.tl-node {
  position: absolute; left: 8px; top: 3px;
  width: 26px; height: 26px; border-radius: 50%;
  background: var(--white); border: 2.5px solid var(--blue);
  display: flex; align-items: center; justify-content: center;
  z-index: 1; box-shadow: 0 0 0 4px var(--ivory);
}
.tl-node.past { border-color: var(--faint); }
.tl-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--blue); }
.tl-node.past .tl-dot { background: var(--faint); }

.tl-head {
  display: flex; align-items: baseline;
  justify-content: space-between; flex-wrap: wrap; gap: 6px 16px;
  margin-bottom: 3px;
}
.tl-role {
  font-family: var(--display); font-weight: 700;
  font-size: 19px; color: var(--ink); letter-spacing: -.01em;
}
.tl-period { font-family: var(--mono); font-size: 12px; color: var(--muted); }
.tl-org { font-size: 14px; color: var(--muted); margin-bottom: 18px; }
.tl-bullets { display: grid; gap: 10px; }
.tl-bullet {
  display: flex; gap: 10px;
  font-size: 14.5px; color: var(--ink-2); line-height: 1.62;
}
.tl-bullet b { color: var(--ink); font-weight: 600; flex-shrink: 0; }

/* ─── EDUCATION ──────────────────────────────────────── */
.edu-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.edu-card {
  background: var(--white); border: 1px solid var(--faint);
  border-radius: var(--r); padding: 24px; box-shadow: var(--shadow-sm);
  transition: box-shadow .22s, transform .22s var(--spring);
}
.edu-card:hover { box-shadow: var(--shadow-md); transform: translateY(-3px); }
.edu-degree { font-family: var(--display); font-weight: 700; font-size: 16px; color: var(--ink); margin-bottom: 3px; }
.edu-field  { font-size: 14px; color: var(--muted); margin-bottom: 12px; }
.edu-foot   { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 4px; }
.edu-school { font-size: 13px; font-weight: 500; color: var(--ink-2); }
.edu-year   { font-family: var(--mono); font-size: 12px; color: var(--muted); }
@media (max-width: 600px) { .edu-grid { grid-template-columns: 1fr; } }

/* ─── CONTACT ────────────────────────────────────────── */
.contact-wrap {
  display: grid; grid-template-columns: 1fr 1.45fr;
  gap: 64px; align-items: start;
}
.contact-aside h3 {
  font-family: var(--display); font-size: 22px; font-weight: 700;
  color: var(--ink); margin-bottom: 10px; letter-spacing: -.01em;
}
.contact-aside > p { font-size: 15px; color: var(--muted); line-height: 1.68; margin-bottom: 26px; }
.contact-links { display: grid; gap: 10px; }
.contact-link {
  display: flex; align-items: center; gap: 12px;
  font-size: 14px; color: var(--ink-2);
  padding: 11px 16px; background: var(--white);
  border: 1px solid var(--faint); border-radius: var(--r-sm);
  box-shadow: var(--shadow-sm); text-decoration: none;
  transition: box-shadow .22s, transform .22s var(--spring), border-color .22s, color .22s;
}
.contact-link:hover {
  box-shadow: var(--shadow-md); color: var(--blue);
  transform: translateX(5px); border-color: rgba(157,124,255,.25);
  text-decoration: none;
}
.cl-icon {
  width: 34px; height: 34px; border-radius: 8px;
  background: var(--blue-light); display: flex; align-items: center;
  justify-content: center; color: var(--blue); flex-shrink: 0; font-size: 15px;
}

.form-card {
  background: var(--white); border: 1px solid var(--faint);
  border-radius: var(--r); padding: 36px; box-shadow: var(--shadow-md);
}
.form-inner { display: grid; gap: 20px; }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.field { display: grid; gap: 6px; }
label { font-size: 13px; font-weight: 600; color: var(--ink); }
input, textarea {
  background: var(--ivory); border: 1.5px solid var(--faint);
  color: var(--ink); font-family: var(--body); font-size: 14.5px;
  padding: 11px 14px; border-radius: var(--r-sm); width: 100%;
  transition: border-color .2s, box-shadow .2s, background .2s;
}
input:focus, textarea:focus {
  background: var(--white); border-color: var(--blue);
  box-shadow: 0 0 0 3px rgba(157,124,255,.12); outline: none;
}
input::placeholder, textarea::placeholder { color: var(--muted); opacity: .7; }
textarea { resize: vertical; min-height: 120px; }

.btn-send {
  width: 100%; padding: 14px 24px;
  background: var(--ink); color: #fff; border: none;
  border-radius: var(--r-sm);
  font-family: var(--display); font-size: 15px; font-weight: 600;
  cursor: pointer; letter-spacing: -.01em;
  transition: background .2s, transform .25s var(--spring), box-shadow .2s;
}
.btn-send:hover {
  background: var(--blue); transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(157,124,255,.35);
}
.btn-send:active { transform: translateY(0); box-shadow: none; }
.btn-send:disabled { opacity: .55; cursor: not-allowed; transform: none; box-shadow: none; }
.form-status {
  font-size: 13.5px; padding: 11px 14px; border-radius: var(--r-sm);
  display: none; margin-top: -4px;
}
.form-status.ok    { display: block; background: var(--green-bg); color: var(--green); border: 1px solid rgba(95,227,160,.25); }
.form-status.error { display: block; background: #FEF2F2; color: #DC2626; border: 1px solid rgba(220,38,38,.2); }

@media (max-width: 800px) {
  .contact-wrap { grid-template-columns: 1fr; gap: 40px; }
  .form-row { grid-template-columns: 1fr; }
}

/* ─── FOOTER ─────────────────────────────────────────── */
footer {
  margin-top: 104px; padding: 32px 0 56px;
  border-top: 1px solid var(--faint);
}
.footer-inner {
  max-width: 1060px; margin: 0 auto; padding: 0 32px;
  display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;
}
.footer-brand { font-family: var(--display); font-weight: 700; font-size: 15px; color: var(--ink); }
.footer-brand span { color: var(--blue); }
.footer-stack { font-family: var(--mono); font-size: 11.5px; color: var(--muted); }

/* ─── KEYFRAMES ──────────────────────────────────────── */
@keyframes fadeUp {
  to { opacity: 1; transform: translateY(0); }
}

/* ─── REDUCED MOTION ─────────────────────────────────── */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: .01ms !important;
    transition-duration: .01ms !important;
  }
  .orb { animation: none; }
}
</style>
</head>
